    "@ai-sdk/harness-codex": "1.0.160",
    "@clack/prompts": "1.8.1",
    "ai": "7.0.147",
    "diff": "9.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
